{
  "name": "suzeo-game",
  "private": true,
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyungjin87c-ux/spoongame.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite-node scripts/validateEvents.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "sim": "vite-node scripts/simulate.ts",
    "sim:1000": "vite-node scripts/simulate1000.ts",
    "sim:infant": "vite-node scripts/infantMetrics.ts",
    "check:events": "vite-node scripts/validateEvents.ts",
    "check:dist": "vite-node scripts/checkFinalDistribution.ts",
    "check:todo": "vite-node scripts/checkTodoEvidence.ts",
    "check:motifs": "vite-node scripts/validateMotifs.ts",
    "check:basis": "vite-node scripts/checkBasis.ts",
    "check:economy": "vite-node scripts/economyCheck.ts",
    "gen:basis": "vite-node scripts/checkBasis.ts --write",
    "check:citations": "vite-node scripts/syncCitations.ts",
    "gen:citations": "vite-node scripts/syncCitations.ts --write",
    "report:citations": "vite-node scripts/citationExposure.ts",
    "report:notes": "vite-node scripts/noteSchedule.ts",
    "report:time": "vite-node scripts/timeReport.ts",
    "report:parent": "vite-node scripts/parentReport.ts",
    "e2e:prod": "npm run build && playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
